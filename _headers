# A published app is what an install checks. The file is good for a minute,
# so the next publish is the file an install sees. One asterisk matches the
# rest of the path, so this covers every app file.
/apps/*.gif
  Cache-Control: public, max-age=60
  CDN-Cache-Control: public, max-age=60
/_goal.gif
  Cache-Control: public, max-age=60
  CDN-Cache-Control: public, max-age=60
# Android App Links (Digital Asset Links): must be application/json, no redirect.
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
