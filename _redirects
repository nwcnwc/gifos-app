/meet/llms.txt /llms-meet.txt 200
# Bare /meet and /cast are the meeting and broadcast pages themselves (meet.html, cast.html): their loader reads a
# #room=… link as the room. Only the path forms (/meet/R, /meet/R/V, /cast/…, /join…) go through the router.
/meet/* /route 200
/cast/* /route 200
/join/* /route 200
/join /route 200
# Bare /store is the store page itself (never rewrite it: the host 308s /store.html there): route.html hands /store/<slug> to /store#app=<slug>.
/store/* /route 200
